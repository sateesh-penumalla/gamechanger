# BharatQuant MAS Configuration

# 1. Database Configuration
# Default: mysql+pymysql://root@localhost/bharatquant_mas
DATABASE_URL=mysql+pymysql://root@localhost/bharatquant_mas

# 2. AI & Sentiment Configuration
# Get your API key from https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# 3. Data Scraper Settings (Optional)
# Period and interval for yfinance
YF_PERIOD=1d
YF_INTERVAL=5m
